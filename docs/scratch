## General Steps taken to install ArchLinux via bootable USB drive

1. Format the partition
2. mount /mnt
3. wget http:....archlinuxarm.tar.gz
4. gunzip archlinuxarm.tar.gz
5. tar -xpvf archlinuxarm.tar # v prints each file so we can watch the progress - it somehow worked? :shrug:
6. ESP=/dev/nvme0n1p1
7. mkdir -p /mnt/boot/efi && mount $ESP /mnt/boot/efi
8. FW=/root/qcom-firmware # where qcom firmware was placed when the flash drive was flashed with ArchLinux
9. for d in dev proce sys run; do mount --rbind /$d /mnt/$d; done
10. cp -a /root/qcom-firmware/* /mnt/lib/firmware/qcom/
11. chroot /mnt /bin/bash
  a. date -s "2026-07-10 12:00:00"
  b. pacman-key -init && pacman-key --populate archlinuxarm
  c. Fix /etc/resolv.conf: printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8 \n' > /etc/resolv.conf
     ->  pacman -Syyu
  d. ln -sf /usr/share/zoneinfo/America/Vancouver /etc/localtime && hwclock --systohc
  e. local-gen
     echo "LANG=en_US.UTF-8" > /etc/locale.conf
  f. passwd
  g. useradd -mG wheel <you> && passwd <you>
  h. ESP=/dev/nvme0n1p1; ROOT=/dev/nvme0n1p5
  i.
  ```bash
  ROOT_UUID=$(blkid -s UUID -o value /dev/nvme0n1p5)
  ESP_UUID=$(blkid -s UUID -o value /dev/nvme0n1p1)

  cat > /etc/fstab <<EOF
  UUID=$ROOT_UUID /         ext4 defaults 0 1
  UUID=$ESP_UUID /boot/efi  ext4 defaults,noatime 0 2
  EOF
  cat /etc/fstab
