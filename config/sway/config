# Swarmarchy — Sway entry config (Sway reads ~/.config/sway/config)
# Includes the shipped defaults, the theme, then your override files.
# Learn Sway config: man 5 sway

### Variables
set $mod Mod4
set $term xdg-terminal-exec
set $browser swarmarchy-launch-browser
set $fileManager nautilus --new-window

### Swarmarchy Sway defaults (don't edit these directly — change the user files below)
include /usr/share/swarmarchy/default/sway/appearance.conf
include /usr/share/swarmarchy/default/sway/input.conf
include /usr/share/swarmarchy/default/sway/windows.conf
include /usr/share/swarmarchy/default/sway/bindings.conf
include /usr/share/swarmarchy/default/sway/autostart.conf

### Theme (colors + border) — generated by swarmarchy-theme-set from
### default/themed/sway.conf.tpl. Absent until a theme is applied; Sway logs a
### warning if this file is missing but continues.
include ~/.config/swarmarchy/current/theme/sway.conf

### Your own overrides (override anything from the defaults above)
include ~/.config/sway/monitors.conf
include ~/.config/sway/input.conf
include ~/.config/sway/bindings.conf
include ~/.config/sway/looknfeel.conf
include ~/.config/sway/autostart.conf

### Dynamically toggled flags
include ~/.local/state/swarmarchy/toggles/sway/*.conf
