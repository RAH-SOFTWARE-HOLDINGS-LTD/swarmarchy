# Optional container stack. Installed by install/packaging/containers.sh only when
# install/preflight/containers.sh set SWARMARCHY_CONTAINERS=1.

podman                     # rootless, daemonless containers
podman-docker              # `docker` command that runs podman, plus the Docker-compatible API socket
passt                      # pasta: rootless container networking (ports published in userspace, so UFW applies)
docker-compose             # compose files; talks to podman.socket via DOCKER_HOST (see default/bash/envs)
