# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Duplicated from .config/environment.d/sway.conf so SSH works too.
# SWARMARCHY_PATH is the deployed data root; executables sit under /usr/lib.
export SWARMARCHY_PATH=/usr/share/swarmarchy
export PATH=/usr/lib/swarmarchy/bin:$PATH:$HOME/.local/bin
