# Editor used by CLI. Deferred with :- so a real EDITOR from the session wins.
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Duplicated from .config/environment.d/sway.conf so SSH works too.
# SWARMARCHY_PATH is the deployed data root; executables sit under /usr/lib.
export SWARMARCHY_PATH=/usr/share/swarmarchy
if [[ ":$PATH:" != *":/usr/lib/swarmarchy/bin:"* ]]; then
  export PATH=/usr/lib/swarmarchy/bin:$PATH:$HOME/.local/bin
fi

# Point docker-compose and other Docker-API clients at the rootless podman socket
# (enabled by install/first-run/session.sh).
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock"
