#!/bin/bash

# swarmarchy:summary=Reinstall Swarmarchy packages and reset default configs
# swarmarchy:requires-sudo=true

set -e

# Attempt to reinstall all default Swarmarchy packages and reset all the default configs.

echo -e "This will reinstall all the default Swarmarchy packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  swarmarchy-reinstall-git
  swarmarchy-reinstall-pkgs
  swarmarchy-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && swarmarchy-system-reboot
fi
