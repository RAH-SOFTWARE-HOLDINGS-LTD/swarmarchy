#!/bin/bash

# swarmarchy:summary=Reboot after closing application windows
# swarmarchy:examples=swarmarchy reboot | swarmarchy system reboot
# swarmarchy:aliases=swarmarchy reboot

swarmarchy-state clear re*-required

# Arm the reboot in its own session BEFORE closing windows.
#
# swarmarchy-wm-window-close-all kills every window with a pid, which includes
# the menu or terminal this was invoked from -- taking this script's process
# group with it. `nohup` is not enough: it only makes a process ignore SIGHUP,
# it does not leave the process group. Measured directly: under a process-group
# kill a nohup'd child dies and a setsid child survives.
setsid --fork bash -c 'sleep 4; systemctl reboot --no-wall' </dev/null >/dev/null 2>&1

# Now close all windows so apps like Chrome shut down cleanly rather than being
# killed by the session going away underneath them.
swarmarchy-wm-window-close-all
sleep 1

# If this script survived the close, act now rather than waiting out the timer
# above; the armed fallback is then a no-op.
systemctl reboot --no-wall
