#!/bin/bash

# swarmarchy:summary=Launch the default editor from $EDITOR, or nvim if it is unset or missing.
# swarmarchy:args=<path>

swarmarchy-cmd-present "$EDITOR" || EDITOR=nvim

case "$EDITOR" in
nvim | vim | nano | micro | hx | helix | fresh)
  exec swarmarchy-launch-tui "$EDITOR" "$@"
  ;;
*)
  exec setsid "$EDITOR" "$@"
  ;;
esac
