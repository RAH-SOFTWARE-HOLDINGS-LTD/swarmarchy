#!/bin/bash

# swarmarchy:summary=Set the branch for Swarmarchy's git repository.
# swarmarchy:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: swarmarchy-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $SWARMARCHY_PATH switch $branch
