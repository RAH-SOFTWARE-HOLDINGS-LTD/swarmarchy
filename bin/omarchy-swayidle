#!/bin/bash

# omarchy:summary=Start swayidle with Omarchy's idle/lock/sleep timeouts
# omarchy:hidden=true
# Single source of truth for the idle daemon, shared by Sway autostart and
# omarchy-toggle-idle (replaces hypridle + config/hypr/hypridle.conf).

exec swayidle -w \
  timeout 150 'omarchy-launch-screensaver' \
  timeout 152 'omarchy-system-lock' resume 'omarchy-system-wake' \
  before-sleep 'OMARCHY_LOCK_ONLY=true omarchy-system-lock' \
  after-sleep 'sleep 1 && omarchy-system-wake' \
  lock 'omarchy-system-lock'
