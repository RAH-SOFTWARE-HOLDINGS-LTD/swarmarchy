#!/bin/bash

# swarmarchy:summary=Start the Sway session with the user environment loaded.
# swarmarchy:hidden=true
#
# greetd launches the session through a non-interactive login shell, which
# returns from ~/.bashrc at the `[[ $- != *i* ]] && return` guard, and sway is
# not a systemd unit -- so nothing in ~/.config/environment.d/*.conf ever reaches
# the compositor or anything it spawns. Without this, every swarmarchy-* keybind
# silently no-ops (the bin dir is not on PATH) and WLR_RENDERER /
# XDG_CURRENT_DESKTOP / GDK_SCALE are unset.
#
# The user manager has already read environment.d by this point, so take the
# values from it. Going through `show-environment` rather than sourcing the file
# matters: values like QT_QPA_PLATFORM=wayland;xcb contain shell metacharacters
# and systemd emits them properly quoted.

eval "$(systemctl --user show-environment 2>/dev/null | sed 's/^/export /')" 2>/dev/null

# Fallback: if the user manager was not up yet, at least guarantee the swarmarchy
# bin dir resolves, so keybinds work even in the degraded case.
case ":$PATH:" in
  *":/usr/lib/swarmarchy/bin:"*) ;;
  *) export PATH="/usr/lib/swarmarchy/bin:$PATH" ;;
esac

# Keep the session's output off the console.
#
# greetd starts this wrapper on a VT, so sway and EVERY process it spawns inherit
# that tty as stdout and stderr -- waybar, swaybg, mako, the polkit agent, and any
# app launched from a keybind. None of it is visible while the compositor owns the
# screen, so it silently piles up and then scrolls past in one burst the moment sway
# exits and the text console comes back. That burst is what looks like "errors during
# shutdown"; it is just the session's log, and almost all of it is routine.
#
# Send it to a file instead: the console stays clean through logout and reboot, and
# the output is still there to read afterwards. One previous session is kept.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/swarmarchy"
if mkdir -p "$LOG_DIR" 2>/dev/null; then
  [[ -f $LOG_DIR/session.log ]] && mv -f "$LOG_DIR/session.log" "$LOG_DIR/session.log.1"
  exec >"$LOG_DIR/session.log" 2>&1
fi

# Run sway in the foreground (not exec) so the session target can be torn down
# when it exits. Stopping sway-session.target deactivates graphical-session.target
# with it, which stops the portals and OSD daemons in order, before the Wayland
# socket goes away -- otherwise they die on a broken pipe and systemd records a
# failure. It also guarantees the next session starts them with a fresh env.
sway "$@"
rc=$?

systemctl --user stop sway-session.target 2>/dev/null

exit $rc
