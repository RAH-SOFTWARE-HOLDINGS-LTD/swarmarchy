#!/bin/bash

# swarmarchy:summary=Run the full Swarmarchy update pipeline
# swarmarchy:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates (pause swayidle).
# swayidle is a Restart=always service, so stop the unit -- a bare pkill would just
# be respawned mid-update.
systemctl --user stop swayidle.service &>/dev/null || true

# Perform all update steps
swarmarchy-update-keyring
swarmarchy-update-available-reset
swarmarchy-update-system-pkgs
swarmarchy-migrate
swarmarchy-update-aur-pkgs
swarmarchy-update-orphan-pkgs
swarmarchy-hook post-update

swarmarchy-update-analyze-logs

swarmarchy-update-restart

# Re-enable screensaver/sleep after updates (resume swayidle)
systemctl --user start swayidle.service &>/dev/null || true
