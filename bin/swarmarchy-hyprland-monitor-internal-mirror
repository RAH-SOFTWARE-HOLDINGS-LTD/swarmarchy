#!/bin/bash

# swarmarchy:summary=Enable, disable, or toggle mirroring the internal display to an external monitor
# swarmarchy:args=<on|off|toggle|recover>
#
# Ported to Sway: wlroots has NO native output mirroring, so this uses wl-mirror
# (mirrors a source output into a window we fullscreen on the external display).
# wl-mirror is NOT preinstalled — it is offered for install on first use.
# (Filename retained for menu/reference compatibility.)

MIRROR=wl-mirror

INTERNAL=$(swaymsg -t get_outputs | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)
EXTERNAL=$(swaymsg -t get_outputs | jq -r '.[] | select(.name | contains("eDP") | not).name' | head -n 1)

ensure_mirror() {
  command -v "$MIRROR" >/dev/null && return 0
  if command -v gum >/dev/null && gum confirm "wl-mirror is not installed. Install it now?"; then
    swarmarchy-pkg-add wl-mirror && return 0
  fi
  notify-send "󰍹    Mirroring unavailable" "Install it with: swarmarchy-pkg-add wl-mirror" -u critical -t 5000
  return 1
}

enable() {
  if [[ -z $EXTERNAL ]]; then
    notify-send -u low "󰍹    No external monitor found for mirror"
    exit 1
  fi
  if [[ -z $INTERNAL ]]; then
    notify-send -u low "󰍹    No laptop display found to mirror"
    exit 1
  fi
  ensure_mirror || exit 1

  setsid "$MIRROR" "$INTERNAL" >/dev/null 2>&1 &

  # Move the mirror window onto the external output and fullscreen it. Retry a
  # few times because the window takes a moment to appear.
  # NOTE: wl-mirror's app_id is matched loosely; adjust the regex if your build
  # reports a different app_id (check with: swaymsg -t get_tree | grep app_id).
  for _ in 1 2 3 4 5 6; do
    sleep 0.3
    if swaymsg "[app_id=\"(?i)wl[-_.]?mirror\"] move container to output \"$EXTERNAL\", fullscreen enable" >/dev/null 2>&1; then
      break
    fi
  done
  notify-send -u low "󰍹    Mirroring laptop → $EXTERNAL"
}

disable() {
  pkill -x "$MIRROR" && notify-send -u low "󰍹    Extended mode restored"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if pgrep -x "$MIRROR" >/dev/null; then disable; else enable; fi ;;
  recover) pgrep -x "$MIRROR" >/dev/null && ! swaymsg -t get_outputs | jq -e '.[] | select(.name | contains("eDP") | not)' >/dev/null && disable ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
