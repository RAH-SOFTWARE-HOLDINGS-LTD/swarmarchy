#!/bin/bash

# swarmarchy:summary=Print the weather location(s) for wttr.in URLs (empty means auto-detect from the IP)
# swarmarchy:args=[--all]
# swarmarchy:group=weather
# swarmarchy:name=location
#
# Cities live in ~/.config/swarmarchy/weather-location, one per line:
#   Vancouver
#   New York
# The first line is the main city (shown in the bar); --all prints every line, for the
# tooltip and the forecast. Delete the file to go back to guessing from your IP.

cities=()
while IFS= read -r line; do
  [[ -n ${line//[[:space:]]/} ]] && cities+=("${line// /+}")
done < <(cat ~/.config/swarmarchy/weather-location 2>/dev/null)

if [[ ${1:-} == "--all" ]]; then
  (( ${#cities[@]} )) && printf '%s\n' "${cities[@]}"
else
  echo "${cities[0]:-}"
fi
exit 0
