#!/bin/bash

# swarmarchy:summary=Update Swarmarchy and system packages
# swarmarchy:args=[-y]
# swarmarchy:examples=swarmarchy update | swarmarchy update -y
# swarmarchy:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $SWARMARCHY_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env SWARMARCHY_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/swarmarchy-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://omarchy.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || swarmarchy-update-confirm; then
  swarmarchy-snapshot create || (($? == 127))
  swarmarchy-update-git
  swarmarchy-update-perform
fi
