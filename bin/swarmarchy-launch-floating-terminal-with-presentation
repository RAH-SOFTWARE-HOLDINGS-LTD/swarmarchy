#!/bin/bash

# swarmarchy:summary=Launch a floating terminal with the Swarmarchy presentation wrapper
# swarmarchy:args=<command>

cmd="$*"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.swarmarchy.terminal --title=Swarmarchy -e bash -c "swarmarchy-show-logo; $cmd; if (( \$? != 130 )); then swarmarchy-show-done; fi"
