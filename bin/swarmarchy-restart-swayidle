#!/bin/bash

# swarmarchy:summary=Restart the swayidle service (used for idle detection and auto-lock).
# (Ported to Sway; filename retained for compatibility.)

# swayidle runs as a Restart=always user service, so restart it through systemd
# rather than pkill + relaunch (a bare pkill is just undone by the auto-restart, and
# a manual relaunch would race a second instance).
systemctl --user restart swayidle.service
