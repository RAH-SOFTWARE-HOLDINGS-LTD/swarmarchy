#!/bin/bash

# swarmarchy:summary=Display brightness level using SwayOSD on the current monitor.
# swarmarchy:args=<0-100>
# swarmarchy:examples=swarmarchy swayosd brightness 0 | swarmarchy swayosd brightness 50 | swarmarchy swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

swarmarchy-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
