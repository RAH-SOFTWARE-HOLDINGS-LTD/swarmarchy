#!/bin/bash

# swarmarchy:summary=Lock the computer and turn off the display
# swarmarchy:group=system
# swarmarchy:name=lock
# swarmarchy:examples=swarmarchy system lock

if ! pidof swaylock >/dev/null; then
  (
    swaylock
    swarmarchy-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
swaymsg 'input "type:keyboard" xkb_switch_layout 0' >/dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.swarmarchy.screensaver

if [[ ${SWARMARCHY_LOCK_ONLY:-false} != "true" ]]; then
  (
    # Wait for swaylock to actually come up.
    for _ in $(seq 1 30); do pidof swaylock >/dev/null && break; sleep 0.1; done
    pidof swaylock >/dev/null || exit 0

    swarmarchy-brightness-keyboard off

    # Blank the display via a swayidle DPMS stage scoped to this lock, instead of a
    # detached `brightness off`. Because the off/on are one swayidle timeout/resume
    # pair, ANY keypress wakes the screen back to the lock screen -- fixing the old
    # bug where the backlight went off with nothing to restore it and the screen
    # got stuck black with no visual feedback. Torn down when swaylock exits.
    #
    # Which output(s) to blank. Defaults to all ("*"). Machines where blanking an
    # external DP output crashes the GPU -- e.g. Snapdragon X / X1E80100, where the
    # DP-link teardown on DPMS-off wedges the Adreno GMU (unrecoverable) -- can set
    # SWARMARCHY_IDLE_BLANK_OUTPUT=eDP-1 to blank only the internal panel.
    blank_out="${SWARMARCHY_IDLE_BLANK_OUTPUT:-*}"
    swayidle -w \
      timeout 5 "swaymsg \"output $blank_out dpms off\"" \
      resume "swaymsg \"output $blank_out dpms on\"" &
    blanker=$!
    while pidof swaylock >/dev/null; do sleep 0.5; done
    kill "$blanker" 2>/dev/null
    swaymsg "output $blank_out dpms on" >/dev/null 2>&1
  ) &
fi
