#!/bin/bash

# swarmarchy:summary=Set and show lightweight desktop notification reminders
# swarmarchy:args=<minutes> [message] | show | cancel | clear
# swarmarchy:examples=swarmarchy reminder 5 | swarmarchy reminder 30 "Check the oven" | swarmarchy reminder show | swarmarchy reminder cancel | swarmarchy reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

parse_systemd_timespan() {
  local timespan="$1"
  local total=0
  local value unit whole

  while read -r value unit; do
    whole=${value%.*}

    case $unit in
    d) total=$((total + whole * 86400)) ;;
    h) total=$((total + whole * 3600)) ;;
    min) total=$((total + whole * 60)) ;;
    s) total=$((total + whole)) ;;
    ms | us) ;;
    esac
  done < <(grep -oE '[0-9]+([.][0-9]+)?(d|h|min|s|ms|us)' <<<"$timespan" | sed -E 's/^([0-9.]+)([a-z]+)$/\1 \2/')

  echo "$total"
}

# Prints one tab-separated line per pending reminder: <unit> <seconds left> <description> <due time>
pending_reminders() {
  local timers timer next next_seconds uptime unit reminder set_at reminder_minutes description
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/swarmarchy-reminders"

  timers=$(systemctl --user list-timers --all --no-legend --no-pager "swarmarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1) }')
  uptime=${SECONDS_SINCE_BOOT:-$(awk '{ print int($1) }' /proc/uptime)}

  for timer in $timers; do
    next=$(systemctl --user show -P NextElapseUSecMonotonic "$timer" 2>/dev/null || true)
    [[ -z $next ]] && continue

    next_seconds=$(parse_systemd_timespan "$next")
    ((next_seconds <= uptime)) && continue

    unit=${timer%.timer}
    reminder=${unit#swarmarchy-reminder-}
    set_at=${reminder##*-}
    reminder_minutes=${reminder%%m-*}
    description="${reminder_minutes}-min reminder"
    [[ -f $reminder_dir/$unit.message ]] && description=$(<"$reminder_dir/$unit.message")

    printf '%s\t%s\t%s\t%s\n' "$unit" "$((next_seconds - uptime))" "$description" \
      "$(date -d "@$((set_at + reminder_minutes * 60))" +%-H:%M)"
  done
}

show_reminders() {
  local unit remaining description due body=""

  while IFS=$'\t' read -r unit remaining description due; do
    body+="$description in $(format_remaining "$remaining") ($due)"$'\n'
  done < <(pending_reminders)

  if [[ -z $body ]]; then
    swarmarchy-notification-send "󰔛" "Upcoming reminders" "No outstanding reminders" -u low
  else
    swarmarchy-notification-send "󰔛" "Upcoming reminders" "${body%$'\n'}" -u low
  fi
}

# Pick one pending reminder with Walker and stop its timer before it fires
cancel_reminder() {
  local unit remaining description due label base n choice
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/swarmarchy-reminders"
  local -A units descriptions
  local options=()

  while IFS=$'\t' read -r unit remaining description due; do
    base="$description at $due"
    label=$base
    n=2
    while [[ -n ${units[$label]:-} ]]; do
      label="$base ($n)"
      ((n++))
    done
    units[$label]=$unit
    descriptions[$label]=$description
    options+=("$label")
  done < <(pending_reminders)

  if ((${#options[@]} == 0)); then
    swarmarchy-notification-send "󰔛" "No outstanding reminders" -u low
    return
  fi

  choice=$(swarmarchy-menu-select "Cancel reminder" "${options[@]}" -- --width 400) || true
  [[ -z $choice || -z ${units[$choice]:-} ]] && return

  unit=${units[$choice]}
  systemctl --user stop "$unit.timer" || true
  rm -f "$reminder_dir/$unit.message"
  swarmarchy-notification-send "󰔛" "Reminder cancelled" "${descriptions[$choice]}" -u low
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/swarmarchy-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "swarmarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/swarmarchy-reminder-*.message 2>/dev/null || true
  swarmarchy-notification-send "󰔛" "All reminders have been cleared" -u low
}

case ${1:-} in
show | list)
  show_reminders
  exit 0
  ;;
cancel)
  cancel_reminder
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  echo "Usage: swarmarchy-reminder <minutes> [message]"
  echo "       swarmarchy-reminder show"
  echo "       swarmarchy-reminder cancel"
  echo "       swarmarchy-reminder clear"
  exit 1
fi

if [[ -z $message ]]; then
  message="Your ${minutes} minutes are up"
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="swarmarchy-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/swarmarchy-reminders"
message_file="$reminder_dir/$unit.message"
confirmation="You'll be reminded at $remind_at"
confirmation_title="Reminder set for ${minutes} minutes"

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message in ${minutes} minutes"
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
  bash -c 'swarmarchy-notification-send "󰔛" "Reminder" "$1" -u critical; rm -f "$2"' bash "$message" "$message_file"

swarmarchy-notification-send "󰔛" "$confirmation_title" "$confirmation" -u low
