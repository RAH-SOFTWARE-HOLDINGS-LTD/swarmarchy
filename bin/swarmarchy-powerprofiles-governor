#!/bin/bash

# swarmarchy:summary=Set the CPU scaling governor on every core
# swarmarchy:args=<governor>
# swarmarchy:requires-sudo=true

# Whitelisted for passwordless sudo, so it must only ever write a kernel-offered
# governor name into scaling_governor. Never widen what this writes or where.

governor="${1-}"
[[ -n $governor ]] || { echo "usage: swarmarchy-powerprofiles-governor <governor>" >&2; exit 1; }

available=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null) || exit 1
if [[ " $available " != *" $governor "* ]]; then
  echo "unknown governor '$governor' (available: $available)" >&2
  exit 1
fi

for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  echo "$governor" >"$g" 2>/dev/null
done
