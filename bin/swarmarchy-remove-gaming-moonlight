#!/bin/bash

# swarmarchy:summary=Remove Moonlight and its configs and caches.
# swarmarchy:requires-sudo=true

set -e

swarmarchy-pkg-drop moonlight-qt

rm -rf \
  "$HOME/.config/Moonlight Game Streaming Project" \
  "$HOME/.cache/Moonlight Game Streaming Project"

echo ""
echo "Moonlight and its data have been removed."
