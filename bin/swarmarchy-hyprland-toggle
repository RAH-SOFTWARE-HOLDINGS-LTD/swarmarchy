#!/bin/bash

# swarmarchy:summary=Toggle permanent Sway flags by copying them into a directory that's included entirely.
# swarmarchy:args=[--enabled-notification <text>] [--disabled-notification <text>] <flag-name>
# (Ported to Sway; filename retained for compatibility.)

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/swarmarchy/toggles/sway/$FLAG_NAME.conf"
FLAG_SOURCE="$SWARMARCHY_PATH/default/sway/toggles/$FLAG_NAME.conf"

if [[ -f $FLAG ]]; then
  rm $FLAG
  [[ -n $DISABLED_NOTIFICATION ]] && notify-send -u low "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  cp $FLAG_SOURCE $FLAG
  [[ -n $ENABLED_NOTIFICATION ]] && notify-send -u low "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME"
  exit 1
fi

swaymsg reload
