}

show_maintain_menu() {
  case $(menu "Maintain" "  Config\n󰸌  Extra Themes\n  Process\n󰇅  Hardware\n  Password\n  Timezone") in
  *Themes*) present_terminal swarmarchy-theme-update ;;
  *Config*) show_maintain_config_menu ;;
  *Process*) show_maintain_process_menu ;;
  *Hardware*) show_maintain_hardware_menu ;;
  *Timezone*) present_terminal swarmarchy-tz-select ;;
  *Password*) show_maintain_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_maintain_process_menu() {
  case $(menu "Restart" "  Swayidle\n  Nightlight\n󰎟  Mako\n  Swayosd\n󰌧  Walker\n󰍜  Waybar") in
  *Swayidle*) swarmarchy-restart-swayidle ;;
  *Nightlight*) swarmarchy-restart-wlsunset ;;
  *Mako*) swarmarchy-restart-mako ;;
  *Swayosd*) swarmarchy-restart-swayosd ;;
  *Walker*) swarmarchy-restart-walker ;;
  *Waybar*) swarmarchy-restart-waybar ;;
  *) show_maintain_menu ;;
  esac
}

show_maintain_config_menu() {
  case $(menu "Use default config" "  Sway\n  Swaylock\n  Swayosd\n  Tmux\n󰌧  Walker\n󰍜  Waybar") in
  *Swaylock*) present_terminal swarmarchy-refresh-swaylock ;;
  *Swayosd*) present_terminal swarmarchy-refresh-swayosd ;;
  *Sway*) present_terminal swarmarchy-refresh-sway ;;
  *Tmux*) present_terminal swarmarchy-refresh-tmux ;;
  *Walker*) present_terminal swarmarchy-refresh-walker ;;
  *Waybar*) present_terminal swarmarchy-refresh-waybar ;;
  *) show_maintain_menu ;;
  esac
}

show_maintain_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad") in
  *Audio*) present_terminal swarmarchy-restart-pipewire ;;
  *Wi-Fi*) present_terminal swarmarchy-restart-wifi ;;
  *Bluetooth*) present_terminal swarmarchy-restart-bluetooth ;;
  *Trackpad*) present_terminal swarmarchy-restart-trackpad ;;
  *) show_maintain_menu ;;
  esac
}

show_maintain_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_terminal swarmarchy-drive-password ;;
  *User*) present_terminal passwd ;;
  *) show_maintain_menu ;;
  esac
}

show_about() {
  swarmarchy-launch-about
}

show_system_menu() {
  local options="  Lock"
  ! swarmarchy-toggle-enabled suspend-off && options="$options\n󰒲  Suspend"
  swarmarchy-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Lock*) swarmarchy-system-lock ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) systemctl hibernate ;;
  *Logout*) swarmarchy-system-logout ;;
  *Restart*) swarmarchy-system-reboot ;;
  *Shutdown*) swarmarchy-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Maintain\n  About\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *maintain*) show_maintain_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/swarmarchy/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
