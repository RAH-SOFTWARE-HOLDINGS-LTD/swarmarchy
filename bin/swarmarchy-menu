#!/bin/bash

# swarmarchy:summary=Launch the Swarmarchy Menu or takes a parameter to jump straight to a submenu.

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | swarmarchy-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.swarmarchy.terminal "$@"
}

present_terminal() {
  swarmarchy-launch-floating-terminal-with-presentation $1
}

open_in_editor() {
  notify-send -u low "Editing config file" "$1"
  swarmarchy-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; swarmarchy-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; swarmarchy-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; swarmarchy-pkg-add $2 && sleep 2 && swarmarchy-font-set '$3'"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; swarmarchy-pkg-aur-add $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; swarmarchy-pkg-aur-add $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  Swarmarchy\n  Sway\n󰣇  Arch\n  Neovim\n󱆃  Bash") in
  *Keybindings*) swarmarchy-menu-keybindings ;;
  *Swarmarchy*) swarmarchy-launch-webapp "https://learn.omacom.io/2/the-swarmarchy-manual" ;;
  *Sway*) swarmarchy-launch-webapp "https://github.com/swaywm/sway/wiki" ;;
  *Arch*) swarmarchy-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) swarmarchy-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) swarmarchy-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "󰔛  Reminder\n  Capture\n󰧸  Transcode\n  Share\n󰔎  Toggle\n  Hardware") in
  *Reminder*) show_reminder_menu ;;
  *Capture*) show_capture_menu ;;
  *Transcode*) swarmarchy-transcode || back_to show_trigger_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "Reminder" "󰔛  Set one\n󰔛  Show all\n󰔛  Clear all") in
  *Set*) show_custom_reminder_input ;;
  *"Show all"*) swarmarchy-reminder show ;;
  *"Clear all"*) swarmarchy-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(swarmarchy-menu-input "Remind in minutes")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    swarmarchy-notification-send "󰔛" "Invalid reminder" "Enter the number of minutes" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(swarmarchy-menu-input "Reminder message")

  if [[ -n $message ]]; then
    swarmarchy-reminder "$minutes" "$message"
  else
    swarmarchy-reminder "$minutes"
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰴑  Text Extraction") in
  *Screenshot*) swarmarchy-capture-screenshot ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Text*) swarmarchy-capture-text-extraction ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  swarmarchy-capture-screenrecording --stop-recording && exit 0

  case $(menu "Screenrecord" "  With no audio\n  With desktop audio\n  With desktop + microphone audio\n  With desktop + microphone audio + webcam") in
  *"With no audio") swarmarchy-capture-screenrecording ;;
  *"With desktop audio") swarmarchy-capture-screenrecording --with-desktop-audio ;;
  *"With desktop + microphone audio") swarmarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"With desktop + microphone audio + webcam")
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    swarmarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder") in
  *Clipboard*) swarmarchy-menu-share clipboard ;;
  *File*) terminal bash -c "swarmarchy-menu-share file" ;;
  *Folder*) terminal bash -c "swarmarchy-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local options="󰔎  Nightlight\n󱫖  Idle Lock\n󰂛  Notifications\n󰍜  Top Bar\n󰍹  Monitor Scaling\n  Direct Boot\n󰟵  Passwordless Sudo"

  case $(menu "Toggle" "$options") in
  *Nightlight*) swarmarchy-toggle-nightlight ;;
  *Idle*) swarmarchy-toggle-idle ;;
  *Notifications*) swarmarchy-toggle-notification-silencing ;;
  *Bar*) swarmarchy-toggle-waybar ;;
  *Scaling*) swarmarchy-wm-monitor-scaling-cycle ;;
  *"Direct Boot"*) present_terminal swarmarchy-config-direct-boot ;;
  *"Passwordless Sudo"*) present_terminal swarmarchy-sudo-passwordless ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options="󰛧  Laptop Display\n 󰍹  Mirror Display"

  if swarmarchy-hw-touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if swarmarchy-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *Laptop*) swarmarchy-wm-monitor-internal toggle ;;
  *Mirror*) swarmarchy-wm-monitor-internal-mirror toggle ;;
  *Touchpad*) swarmarchy-toggle-touchpad ;;
  *Touchscreen*) swarmarchy-toggle-touchscreen ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n󰟵  Unlock\n  Font\n  Background\n  Sway") in
  *Theme*) show_theme_menu ;;
  *Unlock*) swarmarchy-launch-walker -m menus:swarmarchyunlocks --width 800 --minheight 400 ;;
  *Font*) show_font_menu ;;
  *Background*) show_background_menu ;;
  *Sway*) open_in_editor ~/.config/sway/looknfeel.conf ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  swarmarchy-launch-walker -m menus:swarmarchythemes --width 800 --minheight 400
}

show_background_menu() {
  swarmarchy-launch-walker -m menus:swarmarchyBackgroundSelector --width 800 --minheight 400
}

show_font_menu() {
  theme=$(menu "Font" "$(swarmarchy-font-list)" "--width 350" "$(swarmarchy-font-current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_style_menu
  else
    swarmarchy-font-set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n  System Sleep\n󰍹  Monitors"
  [[ -f ~/.config/sway/bindings.conf ]] && options="$options\n  Keybindings"
  [[ -f ~/.config/sway/input.conf ]] && options="$options\n  Input"
  options="$options\n  Defaults\n󰱔  DNS\n  Security\n  Config"

  case $(menu "Setup" "$options") in
  *Audio*) swarmarchy-launch-audio ;;
  *Wifi*) swarmarchy-launch-wifi ;;
  *Bluetooth*) swarmarchy-launch-bluetooth ;;
  *Power*) show_setup_power_menu ;;
  *System*) show_setup_system_menu ;;
  *Monitors*) open_in_editor ~/.config/sway/monitors.conf ;;
  *Keybindings*) open_in_editor ~/.config/sway/bindings.conf ;;
  *Input*) open_in_editor ~/.config/sway/input.conf ;;
  *Defaults*) show_setup_default_browser_menu ;;
  *DNS*) present_terminal swarmarchy-setup-dns ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(swarmarchy-powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ $profile == "CNCLD" || -z $profile ]]; then
    back_to show_setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2") in
  *Fingerprint*) present_terminal swarmarchy-setup-security-fingerprint ;;
  *Fido2*) present_terminal swarmarchy-setup-security-fido2 ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}

show_setup_default_browser_menu() {
  local options=""
  browser_desktop_exists google-chrome.desktop && options="${options:+$options\n}󰊯  Chrome"
  browser_desktop_exists brave-browser.desktop && options="${options:+$options\n}󰖟  Brave"
  browser_desktop_exists brave-origin-beta.desktop && options="${options:+$options\n}󰖟  Brave Origin"
  browser_desktop_exists microsoft-edge.desktop && options="${options:+$options\n}󰇩  Edge"
  browser_desktop_exists firefox.desktop && options="${options:+$options\n}󰈹  Firefox"
  browser_desktop_exists zen.desktop && options="${options:+$options\n}󰖟  Zen"

  local current=""
  case "$(swarmarchy-default-browser)" in
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  brave-origin) current="󰖟  Brave Origin" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  esac

  case $(menu "Default Browser" "$options" "" "$current") in
  *Chrome*) swarmarchy-default-browser chrome ;;
  *"Brave Origin"*) swarmarchy-default-browser brave-origin ;;
  *Brave*) swarmarchy-default-browser brave ;;
  *Edge*) swarmarchy-default-browser edge ;;
  *Firefox*) swarmarchy-default-browser firefox ;;
  *Zen*) swarmarchy-default-browser zen ;;
  *) show_setup_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "Setup" "  Sway\n  Swaylock\n  Swayosd\n󰌧  Walker\n󰍜  Waybar") in
  *Swaylock*) open_in_editor ~/.config/swaylock/config ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml && swarmarchy-restart-swayosd ;;
  *Sway*) open_in_editor ~/.config/sway/config && swarmarchy-restart-sway ;;
  *Walker*) open_in_editor ~/.config/walker/config.toml && swarmarchy-restart-walker ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc && swarmarchy-restart-waybar ;;
  *) show_setup_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

  if swarmarchy-toggle-enabled suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  if swarmarchy-hibernation-available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) swarmarchy-toggle-suspend ;;
  *"Enable Hibernate"*) present_terminal swarmarchy-hibernation-setup ;;
  *"Disable Hibernate"*) present_terminal swarmarchy-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI\n  Service\n  Style\n󰵮  Development\n  Editor\n  Browser\n󱚤  AI") in
  *Package*) terminal swarmarchy-pkg-install ;;
  *AUR*) terminal swarmarchy-pkg-aur-install ;;
  *Web*) present_terminal swarmarchy-webapp-install ;;
  *TUI*) present_terminal swarmarchy-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Style*) show_install_style_menu ;;
  *Development*) show_install_development_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Browser*) show_install_browser_menu ;;
  *AI*) show_install_ai_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_browser_menu() {
  case $(menu "Install" "  Chrome\n  Edge\n  Brave\n  Brave Origin\n  Firefox\n󰖟  Zen") in
  *Chrome*) present_terminal "swarmarchy-install-browser chrome" ;;
  *Edge*) present_terminal "swarmarchy-install-browser edge" ;;
  *"Brave Origin"*) present_terminal "swarmarchy-install-browser brave-origin" ;;
  *Brave*) present_terminal "swarmarchy-install-browser brave" ;;
  *Firefox*) present_terminal "swarmarchy-install-browser firefox" ;;
  *Zen*) present_terminal "swarmarchy-install-browser zen" ;;
  *) show_install_menu ;;
  esac
}

show_install_service_menu() {
  case $(menu "Install" "󰟵  Bitwarden") in
  *Bitwarden*) install_and_launch "Bitwarden" "bitwarden bitwarden-cli" "bitwarden" ;;
  *) show_install_menu ;;
  esac
}

show_install_editor_menu() {
  case $(menu "Install" "  Cursor\n  Sublime Text\n  Emacs") in
  *Cursor*) install_and_launch "Cursor" "cursor-bin" "cursor" ;;
  *Sublime*) install_and_launch "Sublime Text" "sublime-text-4" "sublime_text" ;;
  *Emacs*) install "Emacs" "emacs-wayland" && systemctl --user enable --now emacs.service ;;
  *) show_install_menu ;;
  esac
}

show_install_ai_menu() {
  ollama_pkg=$(
    (swarmarchy-cmd-present nvidia-smi && echo ollama-cuda) ||
      (swarmarchy-cmd-present rocminfo && echo ollama-rocm) ||
      echo ollama
  )

  case $(menu "Install" "󱚤  LM Studio\n󱚤  Ollama\n󱚤  Crush") in
  *Studio*) install "LM Studio" "lmstudio-bin" ;;
  *Ollama*) install "Ollama" $ollama_pkg ;;
  *Crush*) install "Crush" "crush-bin" ;;
  *) show_install_menu ;;
  esac
}

show_install_style_menu() {
  case $(menu "Install" "󰸌  Theme\n  Background\n  Font") in
  *Theme*) present_terminal swarmarchy-theme-install ;;
  *Background*) swarmarchy-theme-bg-install ;;
  *Font*) show_install_font_menu ;;
  *) show_install_menu ;;
  esac
}

show_install_font_menu() {
  case $(menu "Install" "  Cascadia Mono\n  Meslo LG Mono\n  Fira Code\n  Victor Code\n  Bitstream Vera Mono\n  Iosevka" "--width 350") in
  *Cascadia*) install_font "Cascadia Mono" "ttf-cascadia-mono-nerd" "CaskaydiaMono Nerd Font" ;;
  *Meslo*) install_font "Meslo LG Mono" "ttf-meslo-nerd" "MesloLGL Nerd Font" ;;
  *Fira*) install_font "Fira Code" "ttf-firacode-nerd" "FiraCode Nerd Font" ;;
  *Victor*) install_font "Victor Code" "ttf-victor-mono-nerd" "VictorMono Nerd Font" ;;
  *Bitstream*) install_font "Bitstream Vera Code" "ttf-bitstream-vera-mono-nerd" "BitstromWera Nerd Font" ;;
  *Iosevka*) install_font "Iosevka" "ttf-iosevka-nerd" "Iosevka Nerd Font Mono" ;;
  *) show_install_menu ;;
  esac
}

