#!/bin/bash

# swarmarchy:summary=Shut down after closing application windows
# swarmarchy:examples=swarmarchy shutdown | swarmarchy system shutdown
# swarmarchy:aliases=swarmarchy shutdown

swarmarchy-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &

# Now close all windows
swarmarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
