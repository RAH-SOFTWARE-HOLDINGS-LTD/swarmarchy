#!/bin/bash

# swarmarchy:summary=Enable, disable, toggle, or recover the internal laptop display
# swarmarchy:args=<on|off|toggle|recover>
# (Ported to Sway; filename retained for compatibility.)

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/swarmarchy/toggles/sway/$TOGGLE.conf"
MIRROR_TOGGLE="internal-monitor-mirror"

# Get internal monitor name dynamically
INTERNAL=$(swaymsg -t get_outputs | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)

enable() {
  if swarmarchy-wm-toggle-enabled "$TOGGLE"; then
    swarmarchy-wm-toggle --disabled-notification "󰍹    Laptop display enabled" "$TOGGLE"
  fi
  # Sway reload won't re-enable an output on its own, so do it explicitly.
  [[ -n $INTERNAL ]] && swaymsg output "$INTERNAL" enable
}

disable() {
  if ! swarmarchy-hw-external-monitors; then
    notify-send -u low "󰍹    Can't disable the only active display"
    exit 1
  fi
  if swarmarchy-wm-toggle-disabled "$TOGGLE" && swarmarchy-wm-toggle-disabled "$MIRROR_TOGGLE"; then
    echo "output $INTERNAL disable" >"$TOGGLE_FLAG"
    notify-send -u low "󰍹    Laptop display disabled"
    swaymsg reload
  fi
}

recover() {
  if ! swarmarchy-hw-external-monitors && swarmarchy-wm-toggle-enabled "$TOGGLE"; then
    swarmarchy-wm-toggle "$TOGGLE"
    [[ -n $INTERNAL ]] && swaymsg output "$INTERNAL" enable
  fi
}

case "$1" in
  on) enable ;;
  off) disable ;;
  toggle) if swarmarchy-wm-toggle-enabled "$TOGGLE"; then enable; else disable; fi ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
