#!/bin/bash

# swarmarchy:summary=Turn the keyring (oo7) password on or off -- off by default
# swarmarchy:group=toggle
# swarmarchy:name=keyring-password
# swarmarchy:args=[on|off|status]
# swarmarchy:examples=swarmarchy toggle keyring-password status | swarmarchy toggle keyring-password on
# swarmarchy:requires-sudo=true

# off (default): the keyring is encrypted with a fixed, published value that oo7 reads
#   from its systemd credential at startup (no-password.conf), so it unlocks on its own.
# on: the keyring is encrypted with your login password, which the login (pam_oo7)
#   hands to oo7 (pam-greetd-protected + wait-for-pam-socket.conf).
#
# Switching re-encrypts ~/.local/share/keyrings/v1/login.keyring with oo7-cli. oo7-cli
# always talks to a running Secret Service, and the real oo7-daemon must not hold the
# keyring open while the file changes (it would write it back with the old key), so
# the re-encryption runs against a private oo7-daemon on a private D-Bus that cannot
# auto-start anything; it loads the keyring locked and never writes it. Your password
# is typed into oo7-cli's own prompt -- never put on a command line or in a file.
# A wrong password is rejected by oo7-cli and leaves the keyring untouched.

set -e

FIXED=swarmarchy-no-password
KEYRING=$HOME/.local/share/keyrings/v1/login.keyring
DROPIN_DIR=$HOME/.config/systemd/user/oo7-daemon.service.d
DEFAULTS=/usr/share/swarmarchy/default/oo7
NO_PASSWORD_CONF=/etc/skel/.config/systemd/user/oo7-daemon.service.d/no-password.conf

state() {
  if grep -q 'pam_oo7.so' /etc/pam.d/greetd 2>/dev/null; then echo on; else echo off; fi
}

keyring_locked() {
  busctl --user get-property org.freedesktop.secrets /org/freedesktop/secrets/aliases/default \
    org.freedesktop.Secret.Collection Locked 2>/dev/null | awk '{print $2}'
}

# Run oo7-cli -k KEYRING "$@" against a private oo7-daemon.
rekey() {
  local work rc=0
  work=$(mktemp -d /tmp/swarmarchy-keyring.XXXX)
  mkdir -p "$work/run" "$work/none"
  chmod 700 "$work/run"
  cat >"$work/bus.conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig><type>session</type><listen>unix:tmpdir=$work</listen><auth>EXTERNAL</auth>
<servicedir>$work/none</servicedir>
<policy context="default"><allow send_destination="*" eavesdrop="true"/><allow eavesdrop="true"/><allow own="*"/></policy></busconfig>
EOF
  dbus-run-session --config-file="$work/bus.conf" -- bash -c '
    env -u CREDENTIALS_DIRECTORY XDG_RUNTIME_DIR="$1" /usr/lib/oo7-daemon >/dev/null 2>&1 &
    pid=$!
    for (( i = 0; i < 50; i++ )); do
      dbus-send --session --print-reply --dest=org.freedesktop.DBus / \
        org.freedesktop.DBus.NameHasOwner string:org.freedesktop.secrets 2>/dev/null |
        grep -q "boolean true" && break
      sleep 0.1
    done
    shift
    oo7-cli "$@"
    rc=$?
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    exit $rc
  ' _ "$work/run" -k "$KEYRING" "$@" 2> >(grep -v '^dbus-daemon' >&2) || rc=$?
  rm -rf "$work"
  return $rc
}

need_terminal() {
  if [[ ! -t 0 ]]; then
    echo "Run this in a terminal: it asks for a password." >&2
    exit 1
  fi
}

case ${1:-status} in
  status)
    echo "Keyring password: $(state)  (keyring currently locked: $(keyring_locked || echo unknown))"
    ;;

  off)
    if [[ $(state) == "off" ]]; then
      echo "The keyring password is already off."
      exit 0
    fi
    need_terminal
    echo "Turning the keyring password off. Close Brave and other browsers first."
    systemctl --user stop oo7-daemon.service
    if [[ -f $KEYRING ]]; then
      echo "When asked for the \"Keyring secret\", type your current LOGIN password."
      if ! rekey change-secret "$FIXED"; then
        echo "Not changed (wrong password?). The keyring is as it was." >&2
        systemctl --user start oo7-daemon.service
        exit 1
      fi
    fi
    mkdir -p "$DROPIN_DIR"
    install -m 0644 "$NO_PASSWORD_CONF" "$DROPIN_DIR/no-password.conf"
    rm -f "$DROPIN_DIR/wait-for-pam-socket.conf"
    sudo install -m 0644 "$DEFAULTS/pam-greetd" /etc/pam.d/greetd
    systemctl --user daemon-reload
    systemctl --user start oo7-daemon.service
    if [[ $(keyring_locked) == "false" ]]; then
      echo "Done: the keyring has no password and is unlocked."
    else
      echo "Switched, but the keyring is still locked. Check: journalctl --user -u oo7-daemon -b" >&2
      exit 1
    fi
    ;;

  on)
    if [[ $(state) == "on" ]]; then
      echo "The keyring password is already on."
      exit 0
    fi
    need_terminal
    echo "Turning the keyring password on. Close Brave and other browsers first."
    systemctl --user stop oo7-daemon.service
    if [[ -f $KEYRING ]]; then
      echo "When asked for the \"new secret\", type your LOGIN password exactly -- the login"
      echo "will unlock the keyring with it. If they differ, the keyring stays locked."
      if ! rekey -s "$FIXED" change-secret; then
        echo "Not changed. The keyring is as it was." >&2
        systemctl --user start oo7-daemon.service
        exit 1
      fi
    fi
    mkdir -p "$DROPIN_DIR"
    rm -f "$DROPIN_DIR/no-password.conf"
    install -m 0644 "$DEFAULTS/wait-for-pam-socket.conf" "$DROPIN_DIR/wait-for-pam-socket.conf"
    sudo install -m 0644 "$DEFAULTS/pam-greetd-protected" /etc/pam.d/greetd
    systemctl --user daemon-reload
    echo "Done. Log out and back in: the login now unlocks the keyring with your password."
    echo "(Until then the keyring stays locked.)"
    ;;

  *)
    echo "Usage: swarmarchy toggle keyring-password [on|off|status]" >&2
    exit 1
    ;;
esac
