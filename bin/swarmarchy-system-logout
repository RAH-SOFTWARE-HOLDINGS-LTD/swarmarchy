#!/bin/bash

# swarmarchy:summary=Log out after closing application windows
# swarmarchy:examples=swarmarchy logout | swarmarchy system logout
# swarmarchy:aliases=swarmarchy logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

# Now close all windows
swarmarchy-wm-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
