#!/bin/bash

# swarmarchy:summary=Set the default terminal used by xdg-terminal-exec
# swarmarchy:args=[foot]
# swarmarchy:examples=swarmarchy default terminal foot

if (($# == 0)); then
  desktop_id=$(grep -vE '^($|#)' ~/.config/xdg-terminals.list 2>/dev/null | head -n 1)
  case "$desktop_id" in
  foot.desktop) echo "foot" ;;
  *) echo "$desktop_id" ;;
  esac
  exit 0
fi

case "$1" in
foot) desktop_id="foot.desktop"; name="Foot"; glyph="" ;;
*)
  echo "Usage: swarmarchy-default-terminal <foot>"
  exit 1
  ;;
esac

cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF

notify-send -u low "$glyph    $name is now the default terminal"
