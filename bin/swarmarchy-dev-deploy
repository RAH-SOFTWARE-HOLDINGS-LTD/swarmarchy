#!/bin/bash

# swarmarchy:summary=Install repo files into the system tree (/usr/lib, /usr/share, /etc/skel)
# swarmarchy:args=[--dry-run]
# swarmarchy:examples=swarmarchy dev deploy | swarmarchy dev deploy --dry-run | DESTDIR=/tmp/stage swarmarchy dev deploy
# swarmarchy:requires-sudo=true

# Deploys the repo as a source tree: nothing here requires the checkout to remain
# on the machine afterwards. The layout mirrors what a PKGBUILD's package() would
# stage, so DESTDIR= produces exactly the tree a package would ship.
#
#   $PREFIX/lib/swarmarchy/bin/                            executables
#   $PREFIX/share/swarmarchy/{default,themes,applications} read-only data
#   $PREFIX/bin/swarmarchy                                 dispatcher symlink
#   /etc/skel/.config/                                     skeleton for new users
#   /                                                      system/ tree, verbatim
#
# Executables live under lib/ rather than $PREFIX/bin so that every directory we
# rsync --delete into is one we own outright; deleting stale files out of a shared
# /usr/bin would take the rest of the system with it.
#
# Live ~/.config is never touched. Defaults still reach existing users because
# their configs include $PREFIX/share/swarmarchy/default/... directly.

set -eEo pipefail

DRY_RUN=false
[[ $1 == "--dry-run" ]] && DRY_RUN=true

# Source tree = the repo root two levels up from this script (bin/swarmarchy-dev-deploy).
# Derived from the script's own path, NOT git, so this also deploys from a plain
# unpacked source tree with no .git -- the repo is a source tree you build/deploy
# from (make-install semantics), not a git or runtime dependency.
SRC=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
if [[ ! -d $SRC/bin || ! -d $SRC/default ]]; then
  echo "swarmarchy-dev-deploy: '$SRC' is not a Swarmarchy source tree (missing bin/ + default/)." >&2
  exit 1
fi

# git is only used for optional provenance below; skipped cleanly for a non-git tree.
if git -C "$SRC" rev-parse --git-dir >/dev/null 2>&1; then IS_GIT=true; else IS_GIT=false; fi

PREFIX="${PREFIX:-/usr}"
LIBDIR="$DESTDIR$PREFIX/lib/swarmarchy"
SHARE="$DESTDIR$PREFIX/share/swarmarchy"
SKEL="$DESTDIR/etc/skel"

# Staging into a DESTDIR is an ordinary file copy; only a live deploy needs root.
if [[ -n $DESTDIR ]]; then
  SUDO=()
else
  SUDO=(sudo)
fi

# -a implies -o -g, which would stamp the *source* owner onto the destination:
# deploying as root then leaves /etc files owned by the maintainer's uid, and
# sudo silently ignores a /etc/sudoers.d it does not see as root-owned. --no-o
# --no-g makes the destination owned by whoever runs rsync instead — root on a
# live deploy, the invoking user when staging into a DESTDIR.
RSYNC=(rsync -a --no-owner --no-group --delete)
if $DRY_RUN; then
  RSYNC+=(--dry-run --itemize-changes)
fi

# Refuse to deploy a commit that isn't signed by a trusted key. Off by default so
# unsigned history stays deployable; set SWARMARCHY_VERIFY=1 once commit signing
# is configured (git config gpg.format ssh + user.signingkey + commit.gpgsign).
if [[ ${SWARMARCHY_VERIFY:-0} == 1 ]]; then
  if ! $IS_GIT; then
    echo "SWARMARCHY_VERIFY=1 but '$SRC' is not a git checkout — nothing to verify a signature against." >&2
    exit 1
  fi
  if ! git -C "$SRC" verify-commit HEAD 2>/dev/null; then
    echo "HEAD is unsigned or signed by an untrusted key — refusing to deploy." >&2
    echo "Unset SWARMARCHY_VERIFY to bypass, or sign the commit." >&2
    exit 1
  fi
  echo "Verified signature on $(git -C "$SRC" rev-parse --short HEAD)"
fi

if $IS_GIT; then
  echo "Deploying $(git -C "$SRC" rev-parse --short HEAD) -> ${DESTDIR:-/}"
else
  echo "Deploying $SRC -> ${DESTDIR:-/}"
fi
if $DRY_RUN; then
  echo "(dry run — no changes will be made)"
fi

# ─── Read-only data ───────────────────────────────────────────────────────────
"${SUDO[@]}" install -d "$SHARE"

# install/ ships because parts of it run long after install:
# swarmarchy-first-run sources install/first-run/, swarmarchy-refresh-applications
# sources install/packaging/.
for dir in default themes applications install; do
  [[ -d $SRC/$dir ]] || continue
  "${SUDO[@]}" "${RSYNC[@]}" "$SRC/$dir/" "$SHARE/$dir/"
done

if ! $DRY_RUN; then
  for file in logo.txt icon.txt icon.png version LICENSE; do
    [[ -f $SRC/$file ]] || continue
    "${SUDO[@]}" install -Dm644 "$SRC/$file" "$SHARE/$file"
  done
fi

# ─── Executables ──────────────────────────────────────────────────────────────
# swarmarchy-dev-* are maintainer tools that operate on a checkout, which a
# deployed machine does not have.
"${SUDO[@]}" install -d "$LIBDIR"
"${SUDO[@]}" "${RSYNC[@]}" --exclude='swarmarchy-dev-*' --chmod=F755 \
  "$SRC/bin/" "$LIBDIR/bin/"

# One entry point on the default PATH; the rest resolve through the PATH entry
# that default/bash/envs and config/environment.d/sway.conf provide.
if ! $DRY_RUN; then
  "${SUDO[@]}" install -d "$DESTDIR$PREFIX/bin"
  "${SUDO[@]}" ln -sfn "$PREFIX/lib/swarmarchy/bin/swarmarchy" \
    "$DESTDIR$PREFIX/bin/swarmarchy"
fi

# ─── Skeleton for new users ───────────────────────────────────────────────────
# Copied by useradd at account creation only. It never reaches an existing
# ~/.config, which is the point: user edits are not ours to overwrite.
"${SUDO[@]}" install -d "$SKEL/.config"
"${SUDO[@]}" "${RSYNC[@]}" "$SRC/config/" "$SKEL/.config/"

if [[ -f $SRC/default/bashrc ]] && ! $DRY_RUN; then
  "${SUDO[@]}" install -Dm644 "$SRC/default/bashrc" "$SKEL/.bashrc"
fi

# ─── System tree ──────────────────────────────────────────────────────────────
# system/ mirrors the target filesystem verbatim (system/etc/foo -> /etc/foo).
# Absent until the unconditional install/config scripts are converted to files.
if [[ -d $SRC/system ]]; then
  # No --delete: this tree interleaves with directories owned by other packages,
  # so it may only add and overwrite its own files.
  DEPLOY=(rsync -a --no-owner --no-group)
  if $DRY_RUN; then
    DEPLOY+=(--dry-run --itemize-changes)
  fi
  "${SUDO[@]}" "${DEPLOY[@]}" "$SRC/system/" "$DESTDIR/"

  # sudoers ignores — and warns about — any file that is group- or world-writable.
  if [[ -d $SRC/system/etc/sudoers.d ]] && ! $DRY_RUN; then
    "${SUDO[@]}" chmod 0440 "$DESTDIR/etc/sudoers.d"/*
    # visudo validates the live /etc/sudoers, so it means nothing against a
    # staged tree — only run it when we actually wrote to the real one.
    if [[ -z $DESTDIR ]]; then
      sudo visudo -c >/dev/null
    fi
  fi
fi

# ─── Reload ───────────────────────────────────────────────────────────────────
# A staged tree is not the running system, so reloading it would be wrong.
if [[ -z $DESTDIR ]] && ! $DRY_RUN; then
  sudo systemctl daemon-reload
  sudo sysctl --system >/dev/null 2>&1 || true
fi

if ! $DRY_RUN; then
  echo "Deployed."
fi
