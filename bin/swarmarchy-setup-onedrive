#!/bin/bash

# swarmarchy:summary=Set up OneDrive sync at ~/Onedrive (rclone FUSE mount)
# swarmarchy:args=[--headless]
# swarmarchy:examples=swarmarchy setup onedrive | swarmarchy setup onedrive --headless
# swarmarchy:requires-sudo=true

# Authorizing OneDrive needs a browser, which the installer does not have, so this is the
# step that finishes what install/preflight/onedrive.sh asked about. first-run/onedrive.sh
# opens it automatically on the first login; it is also under Setup in swarmarchy-menu.
#
# --headless passes config_is_local=false, which makes rclone print a command to run on
# another machine that has a browser and wait for the token instead of opening one here.

set -e

HEADLESS=false
if [[ $1 == "--headless" ]]; then
  HEADLESS=true
fi

MOUNT="$HOME/Onedrive"
UNIT=onedrive-mount.service

if ! gum confirm "Set up OneDrive sync at $MOUNT?"; then
  # 130 tells swarmarchy-launch-floating-terminal-with-presentation this was cancelled,
  # so it skips the "done" screen.
  exit 130
fi

# Both ship in swarmarchy-base.packages, so this is a no-op (--needed) on a normal
# install; it recovers a machine where they were removed.
swarmarchy-pkg-add rclone fuse3

if [[ ! -f "$HOME/.config/systemd/user/$UNIT" ]]; then
  echo "Missing ~/.config/systemd/user/$UNIT." >&2
  echo "It ships in config/systemd/user/ — reinstall the config or run 'swarmarchy dev deploy'." >&2
  exit 1
fi

if rclone listremotes 2>/dev/null | grep -qx 'onedrive:'; then
  echo "An 'onedrive:' remote already exists."
  if gum confirm "Re-authorize it? Choosing no keeps the current token."; then
    rclone config reconnect onedrive:
  fi
else
  # drive_type=personal matches a consumer OneDrive account. Everything else takes
  # rclone's default, which is what its own interactive walkthrough would offer.
  if $HEADLESS; then
    rclone config create onedrive onedrive drive_type=personal config_is_local=false
  else
    rclone config create onedrive onedrive drive_type=personal
  fi
fi

mkdir -p "$MOUNT"
systemctl --user daemon-reload
systemctl --user enable --now "$UNIT"

# The unit is Type=notify, so rclone has already signalled readiness by the time
# `enable --now` returns -- a missing mount here is a real failure, not a race.
if findmnt -T "$MOUNT" -t fuse.rclone >/dev/null 2>&1; then
  echo
  echo "OneDrive is mounted at $MOUNT."
else
  echo
  echo "The mount did not come up. Check: systemctl --user status $UNIT" >&2
  exit 1
fi
