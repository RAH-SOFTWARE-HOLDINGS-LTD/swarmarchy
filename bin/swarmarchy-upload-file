#!/bin/bash

# swarmarchy:summary=Upload a file to the configured log endpoint and print its URL
# swarmarchy:args=<file> | --check
# swarmarchy:hidden=true

# Posts a file to the user's own log endpoint (see swarmarchy-iso/log-worker) and prints
# the URL it returns. Configuration, in order of precedence:
#   SWARMARCHY_LOG_UPLOAD_URL    endpoint (not a secret)
#   SWARMARCHY_LOG_UPLOAD_TOKEN  bearer token; if unset, asked for with a masked prompt
# Both can also be set in ~/.config/swarmarchy/log-upload.conf (plain KEY=value lines).
# On the installer ISO they are baked in at build time and forwarded into the chroot.
#
# `--check` exits 0 when an endpoint is configured, so callers can hide their upload
# option instead of offering something that cannot work.

CONF="$HOME/.config/swarmarchy/log-upload.conf"
if [[ -z ${SWARMARCHY_LOG_UPLOAD_URL:-} && -r $CONF ]]; then
  # shellcheck disable=SC1090
  source "$CONF"
fi

if [[ ${1-} == "--check" ]]; then
  [[ -n ${SWARMARCHY_LOG_UPLOAD_URL:-} ]]
  exit
fi

file="${1-}"
if [[ ! -f $file ]]; then
  echo "Usage: swarmarchy-upload-file <file>" >&2
  exit 1
fi

if [[ -z ${SWARMARCHY_LOG_UPLOAD_URL:-} ]]; then
  echo "No log upload endpoint configured (set SWARMARCHY_LOG_UPLOAD_URL)." >&2
  exit 2
fi

token="${SWARMARCHY_LOG_UPLOAD_TOKEN:-}"
if [[ -z $token && -r /dev/tty ]]; then
  read -r -s -p "Upload token: " token </dev/tty >/dev/tty 2>&1
  echo >/dev/tty
fi

if [[ -z $token ]]; then
  echo "No upload token provided." >&2
  exit 2
fi

# The token goes to curl on stdin (`--header @-`), never on the command line, so it
# does not show up in `ps` or /proc/<pid>/cmdline.
response=$(curl -sS --max-time 60 -w '\n%{http_code}' -F "file=@$file" \
  --header @- "$SWARMARCHY_LOG_UPLOAD_URL" <<<"Authorization: Bearer $token") || exit 1
unset token

code="${response##*$'\n'}"
body="${response%$'\n'*}"

case "$code" in
200) printf '%s\n' "$body" ;;
401) echo "Upload rejected: wrong upload token." >&2; exit 1 ;;
413) echo "Upload rejected: file too large." >&2; exit 1 ;;
*) echo "Upload failed (HTTP $code)." >&2; exit 1 ;;
esac
