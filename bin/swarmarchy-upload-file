#!/bin/bash

# swarmarchy:summary=Paste a file to dpaste.org and print its URL
# swarmarchy:args=<file> | --check
# swarmarchy:hidden=true

# Uploads a text file to dpaste.org and prints the URL it returns.
#
# dpaste needs no account, no token and no infrastructure, which is the point: the
# previous endpoint was a self-hosted Cloudflare Worker whose bearer token had to be
# baked into every ISO, and whose absence made the ISO refuse to build at all.
#
# API: https://docs.dpaste.org/api/
#   content   (required) the text, sent as a form field
#   format    url  -> respond with the bare URL plus a newline
#   lexer     _text -> no syntax highlighting
#   expires   seconds; the server only accepts onetime | never | 3600 | 604800 |
#             2592000, so a week is the closest thing to a short retention.
#
# Override the endpoint with SWARMARCHY_PASTE_URL to use another dpaste instance.
#
# `--check` exits 0 when uploading is possible at all, so callers can hide the option
# rather than offer something that cannot work. Callers test reachability themselves.

PASTE_URL="${SWARMARCHY_PASTE_URL:-https://dpaste.org/api/}"
EXPIRES="${SWARMARCHY_PASTE_EXPIRES:-604800}"

# dpaste caps the content it accepts and the end of a log is where the failure is, so
# send the tail rather than risk a rejection on a long log.
MAX_BYTES="${SWARMARCHY_PASTE_MAX_BYTES:-204800}"

if [[ ${1-} == "--check" ]]; then
  command -v curl &>/dev/null
  exit
fi

file="${1-}"
if [[ ! -f $file ]]; then
  echo "Usage: swarmarchy-upload-file <file>" >&2
  exit 1
fi

if ! command -v curl &>/dev/null; then
  echo "curl is required to upload." >&2
  exit 2
fi

payload=$(mktemp) || exit 1
trap 'rm -f "$payload"' EXIT

size=$(stat -c %s "$file")
if (( size > MAX_BYTES )); then
  printf '[truncated: showing the last %s of %s bytes]\n\n' "$MAX_BYTES" "$size" >"$payload"
  tail -c "$MAX_BYTES" "$file" >>"$payload"
else
  cat "$file" >"$payload"
fi

response=$(curl -sS --max-time 60 -w '\n%{http_code}' \
  -F "format=url" \
  -F "lexer=_text" \
  -F "expires=$EXPIRES" \
  -F "content=<$payload" \
  "$PASTE_URL") || exit 1

code="${response##*$'\n'}"
body="${response%$'\n'*}"

case "$code" in
200 | 201) printf '%s\n' "${body//[$'\r\n']/}" ;;
400) echo "Upload rejected: dpaste did not accept the request ($body)." >&2; exit 1 ;;
413) echo "Upload rejected: log too large for dpaste." >&2; exit 1 ;;
429) echo "Upload rejected: rate limited by dpaste; try again shortly." >&2; exit 1 ;;
*) echo "Upload failed (HTTP $code)." >&2; exit 1 ;;
esac
