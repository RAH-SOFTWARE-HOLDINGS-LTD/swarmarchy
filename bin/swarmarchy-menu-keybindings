#!/bin/bash

# swarmarchy:summary=Display Sway keybindings from your config using walker for an interactive search menu.
#
# Sway has no machine-readable binding dump, so we parse the bindings config
# files directly. Each `bindsym`/`bindswitch` is labelled by the `## Description`
# comment written above it (see default/sway/bindings.conf); when a bind has no
# such comment, the command itself is shown.

CONFIG_FILES=(
  "$SWARMARCHY_PATH/default/sway/bindings.conf"
  "$HOME/.config/sway/bindings.conf"
)

output_keybindings() {
  awk '
    FNR == 1 { desc = "" }                     # reset pending description per file

    /^[[:space:]]*## / {                        # description comment for the next bind
      d = $0
      sub(/^[[:space:]]*## /, "", d)
      sub(/[[:space:]]+$/, "", d)
      desc = d
      next
    }

    /^[[:space:]]*(bindsym|bindswitch)[[:space:]]/ {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      sub(/^(bindsym|bindswitch)[[:space:]]+/, "", line)
      while (line ~ /^--[a-z-]+[[:space:]]+/) sub(/^--[a-z-]+[[:space:]]+/, "", line)  # strip flags

      key = line; sub(/[[:space:]].*$/, "", key)          # first token = key combo
      cmd = line; sub(/^[^[:space:]]+[[:space:]]+/, "", cmd)

      action = (desc != "" ? desc : cmd)
      sub(/^exec[[:space:]]+/, "", action)
      gsub(/\$mod/, "SUPER", key)

      gsub(/&/, "\\&amp;", action)
      gsub(/</, "\\&lt;", action)
      gsub(/>/, "\\&gt;", action)

      printf "%-30s → %s\n", key, action
      desc = ""
      next
    }

    /^[[:space:]]*$/ { desc = "" }              # blank line clears a stale description
  ' "${CONFIG_FILES[@]}" 2>/dev/null | sort -u
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  monitor_height=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused == true) | .rect.height')
  menu_height=$(( ${monitor_height:-1080} * 40 / 100 ))

  output_keybindings |
    walker --dmenu -p 'Keybindings' --width 800 --height "$menu_height"
fi
