#!/bin/bash

# swarmarchy:summary=Reinstall all default Swarmarchy packages from the stable channel
# swarmarchy:requires-sudo=true

set -e

# Reinstall all default Swarmarchy packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
swarmarchy-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$SWARMARCHY_PATH/install/swarmarchy-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
