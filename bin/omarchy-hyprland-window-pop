#!/bin/bash

# omarchy:summary=Pop the focused tile out to a fixed floating, pinned window (toggle).
# omarchy:args=[width height x y]
# (Ported to Sway; uses a "pop" mark to track state. Filename retained.)

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

marks=$(swaymsg -t get_tree | jq -r 'recurse(.nodes[]?, .floating_nodes[]?) | select(.focused? == true) | (.marks // []) | join(" ")')

if [[ " $marks " == *" pop "* ]]; then
  # Already popped -> restore to tiling
  swaymsg 'unmark pop, sticky disable, floating disable' >/dev/null
else
  swaymsg "floating enable, resize set width ${width}px height ${height}px, sticky enable, mark --add pop" >/dev/null
  if [[ -n $x && -n $y ]]; then
    swaymsg "move absolute position ${x} ${y}" >/dev/null
  else
    swaymsg "move position center" >/dev/null
  fi
fi
