#!/bin/bash

# swarmarchy:summary=Returns a formatted weather status string with temperature and wind speed.

# Optional fixed location (a city name); empty means wttr.in guesses from your IP.
# Set SWARMARCHY_WEATHER_LOCATION, or write the city to ~/.config/swarmarchy/weather-location.
location=${SWARMARCHY_WEATHER_LOCATION:-$(cat ~/.config/swarmarchy/weather-location 2>/dev/null)}
location=${location// /+}

weather=$(curl -fsS --max-time 4 "https://wttr.in/$location?format=%l|%t|%w" 2>/dev/null | tr -d '\n')

if [[ -z $weather ]]; then
  echo "Weather unavailable"
  exit 1
fi

IFS='|' read -r place temperature wind <<< "$weather"
place=${place%%,*}
place=${place^}
temperature=${temperature#+}

echo "$(swarmarchy-weather-icon)    $place  ·  Temp $temperature  ·  Wind $wind"
