#!/bin/bash

# swarmarchy:summary=List available themes
# swarmarchy:examples=swarmarchy theme list | swarmarchy theme set "Tokyo Night"

{
  find ~/.config/swarmarchy/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$SWARMARCHY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
