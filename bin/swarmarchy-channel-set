#!/bin/bash

# swarmarchy:summary=Set the Swarmarchy channel, which dictates what git branch and package repository is used.
# swarmarchy:args=<stable|rc|edge|dev>
# swarmarchy:requires-sudo=true

if (($# == 0)); then
  echo "Usage: swarmarchy-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") swarmarchy-branch-set "master" && swarmarchy-refresh-pacman "stable" ;;
"rc") swarmarchy-branch-set "rc" && swarmarchy-refresh-pacman "rc" ;;
"edge") swarmarchy-branch-set "master" && swarmarchy-refresh-pacman "edge" ;;
"dev") swarmarchy-branch-set "dev" && swarmarchy-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

swarmarchy-update -y
